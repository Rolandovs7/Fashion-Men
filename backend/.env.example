# ============================================================
# Fashion Men - Variables de Entorno (EJEMPLO)
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env:
#      cp backend/.env.example backend/.env
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA subas el .env real a Git
# ============================================================

# ---------- Base de Datos PostgreSQL ----------
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/fashionmen

# ---------- Seguridad JWT ----------
SECRET_KEY=cambia-esto-por-una-clave-muy-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- CORS ----------
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ---------- IA (Opcional) ----------
IA_API_KEY=
IA_API_URL=

# ---------- Stripe (Opcional) ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
