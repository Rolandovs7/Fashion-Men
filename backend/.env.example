# ============================================================
# Fashion Men / MenStyle - Variables de Entorno (EJEMPLO)
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env:
#      cp backend/.env.example backend/.env
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA subas el .env real a Git
# ============================================================

# ---------- Base de Datos PostgreSQL ----------
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/menstyle_db

# ---------- Seguridad JWT ----------
SECRET_KEY=cambia-esto-por-una-clave-muy-larga-y-aleatoria

# ---------- IA: Google Gemini (RF25) ----------
# Obtén tu API key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-api-key-de-google-ai-studio

# ---------- Stripe: Pasarela de pago (RF19) ----------
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_tu-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_tu-publishable-key
STRIPE_WEBHOOK_SECRET=

# ---------- Email SMTP (Gmail) ----------
# Genera una App Password en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-sin-espacios
SMTP_FROM_NAME=MenStyle

# URL del frontend para construir links en emails
FRONTEND_URL=http://localhost:4200