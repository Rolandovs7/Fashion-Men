@startuml Vista de Casos de Uso por Paquete
!theme plain
skinparam backgroundColor #FAFAFA
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontSize 10
}

title 5.1.3 - Vista de Casos de Uso Agrupados por Paquete

left to right direction

actor "Usuario\n(Admin/Cliente)" as U

rectangle "MenStyle - Vista por Paquetes" {
  
  package "1. Autenticación" {
    usecase "CU01" as A1
    usecase "CU02" as A2
    usecase "CU03" as A3
  }
  
  package "2. Catálogo" {
    usecase "CU07" as B1
    usecase "CU14" as B2
  }
  
  package "3. Inventario" {
    usecase "CU15" as C1
    usecase "CU25" as C2
  }
  
  package "4. Proveedores" {
    usecase "CU26" as D1
  }
  
  package "5. Ventas y Pagos" {
    usecase "CU18" as E1
    usecase "CU21" as E2
  }
  
  package "6. Reservas" {
    usecase "CU24" as F1
  }
  
  package "7. RA" {
    usecase "CU23" as G1
  }
  
  package "8. IA" {
    usecase "CU31" as H1
    usecase "CU32" as H2
  }
  
  package "9. Reportes" {
    usecase "CU29" as I1
    usecase "CU30" as I2
  }
}

U --> A1
U --> B1
U --> C1
U --> D1
U --> E1
U --> F1
U --> G1
U --> H1
U --> I1

@enduml
